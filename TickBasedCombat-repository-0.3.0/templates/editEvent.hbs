<div class="tick-combat-fields">
  <label class="tick-combat-field">
    <span>Name</span>
    <input name="name" type="text" value="{{name}}" autocomplete="off">
  </label>

  <label class="tick-combat-field">
    <span>Notes</span>
    <textarea name="notes" rows="3">{{notes}}</textarea>
  </label>

  <label class="tick-combat-field">
    <span>{{#if isNew}}Start Ticks{{else}}Current Ticks{{/if}}</span>
    <input name="ticks" type="number" step="1" value="{{ticks}}">
  </label>

  {{#if isEvent}}
    <label class="tick-combat-checkbox">
      <input name="repeating" type="checkbox" {{#if repeating}}checked{{/if}}>
      <span>Repeating event</span>
    </label>

    <label class="tick-combat-field">
      <span>Repeat interval (ticks)</span>
      <input name="ffwd" type="number" step="1" value="{{ffwd}}">
    </label>
  {{/if}}
</div>
